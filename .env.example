# Copy to .env for `make run`. Every variable has a working default for the
# compose stack in deploy/, so this file is documentation more than requirement.

# Service
DISPUTE_ADDR=:8090
DISPUTE_DATABASE_URL=postgres://dispute_api:dispute_api@localhost:5432/dispute?sslmode=disable   # least-privileged API login
DISPUTE_MIGRATE_DATABASE_URL=postgres://dispute:dispute@localhost:5432/dispute?sslmode=disable      # schema owner; migrate and seed only
DISPUTE_IDEMPOTENCY_TTL=24h         # stored idempotent responses older than this are swept
DISPUTE_CORS_ORIGINS=http://localhost:3002   # browser origins allowed to call the API with an analyst token
KEYCLOAK_URL=http://localhost:8180  # used by the seed to record each tenant's realm issuer
DISPUTE_SERVICE_KEY=dev-service-key # shared with the frontend server for /internal/sessions; never given to tenants
DISPUTE_INTERNAL_CIDRS=127.0.0.0/8,::1/128   # peers allowed to see /internal/* at all; everyone else gets 404
DISPUTE_RATE_PER_MINUTE=600         # per-tenant request budget; 0 disables
#DISPUTE_ENV=production             # refuses dev defaults for secrets, credentials and TLS at startup

# Frontend server (frontend/src/server/env.ts); all server-only
#DISPUTE_PUBLIC_API_URL=http://localhost:8090   # what the browser calls directly
#OIDC_CLIENT_ID=frontend
#OIDC_CLIENT_SECRET=dev-frontend-secret        # matches deploy/keycloak/render-realms.sh
#APP_URL=http://localhost:3002
#SESSION_SECRET=ZGV2LXNlc3Npb24tc2VjcmV0LTMyLWJ5dGVzLWxvbmc=   # 32 bytes, base64; rotating it signs everyone out
#SESSION_TTL_SECONDS=36000
#WEB_TENANT_LINKS=otp:OTP Bank,erste:Erste Bank
DISPUTE_SHUTDOWN_TIMEOUT_SECONDS=10
DISPUTE_LOG_LEVEL=info              # debug | info | warn | error

# OpenTelemetry: standard variables, read by the SDK. Unset = instrumented but
# nothing exported. `make otel-up` sets these to point at the local LGTM stack.
#OTEL_SERVICE_NAME=dispute-engine
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_TRACES_EXPORTER=otlp        # otlp | console | none
#OTEL_METRICS_EXPORTER=otlp       # otlp | prometheus | console | none
#OTEL_LOGS_EXPORTER=otlp          # otlp | console | none
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
