# Copy to .env for `make run`. Every variable has a working default for the
# compose stack in deploy/, so this file is documentation more than requirement.

# Service
DISPUTE_ADDR=:8090
DISPUTE_DATABASE_URL=postgres://dispute:dispute@localhost:5432/dispute?sslmode=disable
DISPUTE_SHUTDOWN_TIMEOUT_SECONDS=10
DISPUTE_LOG_LEVEL=info              # debug | info | warn | error

# OpenTelemetry: standard variables, read by the SDK. Unset = instrumented but
# nothing exported. `make otel-up` sets these to point at the local LGTM stack.
#OTEL_SERVICE_NAME=dispute-engine
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_TRACES_EXPORTER=otlp        # otlp | console | none
#OTEL_METRICS_EXPORTER=otlp       # otlp | prometheus | console | none
#OTEL_LOGS_EXPORTER=otlp          # otlp | console | none
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
