#!/usr/bin/env bash
# Opens a PR for the current branch with a conventional-commit title and the repo template filled in.
#
#   scripts/create-pr --description "..." [--type feat] [--tests yes|no] [--rollout "..."] [--adr "..."] \
#                     [--title "type(scope): subject"] [--base main] [--draft] [--dry-run]
#
# Title defaults to the subject of the branch's only commit; with several commits it is required.
# Type defaults to the title's prefix, --tests to whether the diff touches *_test.go, --adr to ADR files in the
# diff, --rollout to "direct deploy" unless the diff touches migrations (then it must be given).
# Description: at most 3 sentences about scope and impact, never a diff summary; identifiers are rejected.
set -euo pipefail
source "$(dirname "$0")/lib/common.sh"
require_gh_account

title="" description="" type="" tests="" rollout="" adr="" base="" draft=0 dry=0
while (($#)); do
  case "$1" in
    --title) title="$2"; shift 2 ;;
    --description) description="$2"; shift 2 ;;
    --type) type="$2"; shift 2 ;;
    --tests) tests="$2"; shift 2 ;;
    --rollout) rollout="$2"; shift 2 ;;
    --adr) adr="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --draft) draft=1; shift ;;
    --dry-run|-n) dry=1; shift ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) die "unknown flag $1" ;;
  esac
done

require_feature_branch
require_clean_tree
[[ -z "$base" ]] && base=$(default_branch)
branch=$(current_branch)
range="origin/$base...HEAD"
git rev-parse -q --verify "origin/$base" >/dev/null || range="$base...HEAD"

commits=$(git rev-list --count "$range")
if [[ -z "$title" ]]; then
  ((commits == 1)) || die "branch has $commits commits; pass --title"
  title=$(git log -1 --format=%s)
fi
[[ "$title" =~ ^(feat|fix|chore|refactor|docs|test|perf|build|ci|style)(\([a-z0-9/._-]+\))?!?:\ .+ ]] \
  || die "title must be conventional-commit shaped, got: $title"
[[ -z "$type" ]] && type=${BASH_REMATCH[1]}

[[ -n "$description" ]] || die "--description is required"
"$(dirname "$0")/check-pr-description" "$description"

changed=$(git diff --name-only "$range")
if [[ -z "$tests" ]]; then
  tests=no
  grep -qE '_test\.go$|\.test\.[jt]sx?$' <<<"$changed" && tests=yes || true
fi
[[ "$tests" =~ ^(yes|no)$ ]] || die "--tests must be yes or no"
if [[ -z "$adr" ]]; then
  adr_files=$(grep -E '^docs/adr/[0-9]{4}-.*\.md$' <<<"$changed" || true)
  if [[ -n "$adr_files" ]]; then
    repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner)
    adr=$(sed "s#^#https://github.com/$repo/blob/$branch/#" <<<"$adr_files" | paste -sd' ' -)
  else
    adr="N/A"
  fi
fi
if [[ -z "$rollout" ]]; then
  if grep -q '^backend/migrations/.*\.sql$' <<<"$changed"; then
    die "diff has a migration; pass --rollout (for example 'migration + backfill, run /migrate before rolling the API')"
  fi
  rollout="direct deploy"
fi

body=$(cat <<BODY
**Type**: $type
**Description**: $description
**Tests Included**: $tests
**Rollout**: $rollout
**ADR**: $adr
BODY
)

if ((dry)); then
  printf 'branch: %s -> %s\ntitle: %s\n\n%s\n' "$branch" "$base" "$title" "$body"
  exit 0
fi

if [[ -z "$(git ls-remote --heads origin "$branch")" ]]; then
  git push -u origin "$branch"
else
  git push origin "$branch"
fi
args=(--base "$base" --title "$title" --body "$body")
((draft)) && args+=(--draft)
gh pr create "${args[@]}"
