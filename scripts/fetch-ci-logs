#!/usr/bin/env bash
# Downloads failing job logs for a PR's latest CI run into notes/pr-<n>/ and prints an index.
#
#   scripts/fetch-ci-logs [--pr <number>] [--wait]
set -euo pipefail
source "$(dirname "$0")/lib/common.sh"
require_gh_account

pr="" wait=0
while (($#)); do
  case "$1" in
    --pr) pr="$2"; shift 2 ;;
    --wait) wait=1; shift ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) die "unknown flag $1" ;;
  esac
done

pr=$(resolve_pr "$pr")
head=$(gh pr view "$pr" --json headRefName,headRefOid --jq '.headRefName')
sha=$(gh pr view "$pr" --json headRefOid --jq '.headRefOid')
dir=$(notes_dir "$pr")

run=$(gh run list --branch "$head" --commit "$sha" --limit 1 --json databaseId,status,conclusion --jq '.[0]')
[[ -n "$run" && "$run" != "null" ]] || die "no workflow run for $head@${sha:0:7}"
run_id=$(jq -r .databaseId <<<"$run")

if ((wait)); then gh run watch "$run_id" --exit-status >/dev/null 2>&1 || true; fi
status=$(gh run view "$run_id" --json status,conclusion --jq '"\(.status)/\(.conclusion)"')

gh run view "$run_id" --json jobs --jq '[.jobs[] | select(.conclusion != "success" and .conclusion != "skipped") | {name, conclusion, id: .databaseId, url}]' > "$dir/run-$run_id-jobs.json"
count=$(jq length "$dir/run-$run_id-jobs.json")

{
  echo "pr: #$pr  branch: $head  commit: ${sha:0:7}"
  echo "run: $run_id  status: $status  non-successful jobs: $count"
  jq -r '.[] | "  - \(.conclusion // "in progress")\t\(.name)"' "$dir/run-$run_id-jobs.json"
} | tee "$dir/ci-triage-index.txt"

if ((count > 0)); then
  # Failed-step log only; the full run log buries the failure under setup output.
  gh run view "$run_id" --log-failed > "$dir/run-$run_id-logs.txt" 2>/dev/null || true
  info "logs: $dir/run-$run_id-logs.txt"
fi
