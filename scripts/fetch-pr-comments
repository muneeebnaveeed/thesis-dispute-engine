#!/usr/bin/env bash
# Exports a PR's review threads and conversation comments to notes/pr-<n>/ as JSON and Markdown.
#
#   scripts/fetch-pr-comments [--pr <number>]
set -euo pipefail
source "$(dirname "$0")/lib/common.sh"
require_gh_account

pr=""
while (($#)); do
  case "$1" in
    --pr) pr="$2"; shift 2 ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) die "unknown flag $1" ;;
  esac
done

pr=$(resolve_pr "$pr")
dir=$(notes_dir "$pr")
owner=$(gh repo view --json owner --jq .owner.login)
name=$(gh repo view --json name --jq .name)

# GraphQL is the only API that exposes thread resolution state.
gh api graphql -F owner="$owner" -F name="$name" -F pr="$pr" -f query='
query($owner:String!,$name:String!,$pr:Int!){
  repository(owner:$owner,name:$name){ pullRequest(number:$pr){
    title url
    reviewThreads(first:100){ nodes{ isResolved isOutdated path line
      comments(first:50){ nodes{ author{login} body createdAt url } } } }
    comments(first:100){ nodes{ author{login} body createdAt url } }
    reviews(first:50){ nodes{ author{login} state body submittedAt url } }
  } } }' > "$dir/pr-comments.json"

jq -r '
  .data.repository.pullRequest as $p |
  "# \($p.title)\n\($p.url)\n",
  "## Review threads (\($p.reviewThreads.nodes | length))\n",
  ($p.reviewThreads.nodes[] |
    "### \(if .isResolved then "resolved" else "OPEN" end)\(if .isOutdated then ", outdated" else "" end): \(.path):\(.line // "-")\n" +
    ([.comments.nodes[] | "- **\(.author.login)** (\(.createdAt)): \(.body | gsub("\n";" "))"] | join("\n")) + "\n"),
  "## Reviews\n",
  ($p.reviews.nodes[] | select(.body != "" or .state != "COMMENTED") | "- **\(.author.login)** \(.state) (\(.submittedAt)): \(.body | gsub("\n";" "))"),
  "\n## Conversation\n",
  ($p.comments.nodes[] | "- **\(.author.login)** (\(.createdAt)): \(.body | gsub("\n";" "))")
' "$dir/pr-comments.json" > "$dir/pr-comments.md"

open=$(jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved | not)] | length' "$dir/pr-comments.json")
info "pr #$pr: $open open review thread(s); wrote $dir/pr-comments.{json,md}"
