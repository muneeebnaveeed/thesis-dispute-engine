#!/usr/bin/env bash
# Writes the thesis's entity relationship diagram (docs/thesis/latex/figures/src/erd.dot) from the migrated schema.
# Keys and relationships come from the database; only the choice of tables and extra columns is made here.
# Usage: make db:up db:migrate thesis:erd thesis:figures
set -euo pipefail

DB_URL="${DISPUTE_MIGRATE_DATABASE_URL:-postgres://dispute:dispute@localhost:5432/dispute?sslmode=disable}"
OUT="docs/thesis/latex/figures/src/erd.dot"
HEAD="#0F6E56"
ROW="#F6FBF9"

# table: columns shown besides the keys
TABLES=(
  "tenants:slug"
  "teams:name"
  "team_members:role"
  "role_grants:amount_limit"
  "accounts:tenant_id currency"
  "transactions:rail amount"
  "disputes:regime state version"
  "dispute_events:event actor_id"
  "dispute_deadlines:due_at"
  "ledger_entries:amount reference"
  "questionnaires:answers"
  "risk_assessments:tier"
  "notices:kind sent_at"
)

q() { psql "$DB_URL" -Atq -F '|' -c "$1"; }

names=$(printf "'%s'," "${TABLES[@]%%:*}"); names=${names%,}

pks=$(q "select tc.table_name, k.column_name from information_schema.table_constraints tc
  join information_schema.key_column_usage k using (constraint_schema, constraint_name, table_name)
  where tc.constraint_type = 'PRIMARY KEY' and tc.table_schema = 'public' and tc.table_name in ($names)")

fks=$(q "select c.conrelid::regclass, a.attname, c.confrelid::regclass, af.attname from pg_constraint c
  cross join lateral unnest(c.conkey, c.confkey) k(n, nf)
  join pg_attribute a on a.attrelid = c.conrelid and a.attnum = k.n
  join pg_attribute af on af.attrelid = c.confrelid and af.attnum = k.nf
  where c.contype = 'f' and c.conrelid::regclass::text in ($names) and c.confrelid::regclass::text in ($names)")

rls=$(q "select relname from pg_class where relkind = 'r' and relrowsecurity and relname in ($names)")

is_pk() { awk -F'|' -v t="$1" -v c="$2" '$1 == t && $2 == c { f = 1 } END { exit !f }' <<<"$pks"; }
is_fk() { awk -F'|' -v t="$1" -v c="$2" '$1 == t && $2 == c { f = 1 } END { exit !f }' <<<"$fks"; }

{
  echo "// Generated by scripts/erd from the migrated schema; do not edit."
  echo "digraph erd {"
  echo "  graph [rankdir=LR, nodesep=0.12, ranksep=0.35, pad=0.05, fontname=\"Liberation Sans\"];"
  echo "  node [shape=plain, fontname=\"Liberation Sans\", fontsize=10];"
  echo "  edge [color=\"#5F5E5A\", arrowhead=crow, arrowtail=tee, dir=both, penwidth=0.8];"
  for entry in "${TABLES[@]}"; do
    t=${entry%%:*}; extra=${entry#*:}
    badge=""; grep -qx "$t" <<<"$rls" && badge=" <font point-size=\"8\">RLS</font>"
    echo "  $t [label=<<table border=\"0\" cellborder=\"0\" cellspacing=\"0\" cellpadding=\"2\" style=\"rounded\" bgcolor=\"$ROW\" color=\"$HEAD\">"
    echo "    <tr><td bgcolor=\"$HEAD\" style=\"rounded\" colspan=\"2\"><font color=\"white\"><b>$t</b>$badge</font></td></tr>"
    cols=$( { awk -F'|' -v t="$t" '$1 == t { print $2 }' <<<"$pks"; awk -F'|' -v t="$t" '$1 == t && $2 != "tenant_id" { print $2 }' <<<"$fks"; tr ' ' '\n' <<<"$extra"; } | awk 'NF && !seen[$0]++')
    for c in $cols; do
      mark=""; is_pk "$t" "$c" && mark="PK"; is_fk "$t" "$c" && mark="${mark:+$mark }FK"
      name=$c; [[ $mark == PK* ]] && name="<b>$c</b>"
      echo "    <tr><td align=\"left\" port=\"w_$c\">$name</td><td align=\"right\" port=\"e_$c\">${mark:+<font color=\"#0F6E56\" point-size=\"8\">$mark</font>}</td></tr>"
    done
    echo "  </table>>];"
  done
  # one edge per foreign key, drawn on its non-tenant column; every table also references tenants, which the
  # caption says once instead of drawing a dozen edges, so only the roots of the tree are linked to it
  awk -F'|' '$2 != "tenant_id" || ($3 == "tenants" && ($1 == "accounts" || $1 == "teams")) { print }' <<<"$fks" |
    awk -F'|' '$1 != $3 && !seen[$1 FS $3]++ { printf "  %s:e_%s:e -> %s:w_%s:w;\n", $3, $4, $1, $2 }'
  # the dispute's six dependants in two columns rather than one, so the figure is wide rather than tall
  echo "  dispute_events -> questionnaires [style=invis]; dispute_deadlines -> risk_assessments [style=invis];"
  echo "  ledger_entries -> notices [style=invis];"
  echo "}"
} >"$OUT"
echo "$OUT"
