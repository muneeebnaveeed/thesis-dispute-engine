// Figure: two credential kinds resolving to one tenant context. From docs/authentication.md and ADR 0009, 0010.
digraph credentials {
  rankdir=LR; splines=ortho; nodesep=0.35; ranksep=0.5; newrank=true;
  node [shape=box, style="rounded,filled", fillcolor=white, color="gray35", fontname="Times", fontsize=15];
  edge [color="gray35", penwidth=1.6, arrowsize=1.0];

  subgraph cluster_key {
    label="A tenant's systems"; labelloc=t; labeljust=l; fontname="Times"; fontsize=14;
    style=solid; penwidth=1.4; bgcolor="#e7f5ea"; pencolor="#3b8a50"; fontcolor="#3b8a50";
    system [label="Online bank,\ncard platform\n(tenant key)"];
    keylookup [label="Hash the key, look it up,\nrefuse if revoked"];
  }
  subgraph cluster_jwt {
    label="A tenant's analysts"; labelloc=b; labeljust=l; fontname="Times"; fontsize=14;
    style=solid; penwidth=1.4; bgcolor="#e8f1fb"; pencolor="#3f73a8"; fontcolor="#3f73a8";
    analyst [label="Workbench server\n(analyst's access token)"];
    verify [label="Issuer picks the realm;\ncheck signature, expiry,\naudience, tenant claim"];
  }
  ctx [label="Request context\ntenant + principal", fillcolor="#fffbe6"];
  tx [label="Transaction binds\napp.tenant_id, app.subject"];
  rls [label="Row-level security\nscopes every query", fillcolor="#fdefe1", color="#b8691f"];

  system -> keylookup;
  analyst -> verify;
  keylookup -> ctx;
  verify -> ctx;
  ctx -> tx -> rls;
}
