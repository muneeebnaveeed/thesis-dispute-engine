# Loaded by `make otel-up`; points the API at the local Jaeger from compose.yml.
# Metrics are off because Jaeger only ingests traces; switch to a collector or
# Prometheus (OTEL_METRICS_EXPORTER=prometheus) when metrics need a sink.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
