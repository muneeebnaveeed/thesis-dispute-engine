@id("grant:chargebacks/junior/ISSUE_FINAL_CREDIT")
permit (principal in TeamRole::"chargebacks/junior", action == Action::"ISSUE_FINAL_CREDIT", resource in Team::"chargebacks")
when { resource.amount.lessThanOrEqual(decimal("500.0000")) };

