{
  "name": "@dispute-engine/frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "knip": "knip",
    "fmt": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "node scripts/generate-api.ts && oxfmt src/api",
    "generate:check": "bash scripts/generate-check.sh",
    "shadcn": "node scripts/shadcn.ts",
    "screenshot": "node scripts/screenshot.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "openapi-fetch": "^0.17.0",
    "openid-client": "^6.8.8",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "^0.4.0",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^26.0.0",
    "knip": "^6.37.0",
    "nitro": "3.0.260610-beta",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.30.0",
    "oxlint": "^1.30.0",
    "oxlint-tsgolint": "^0.20.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.5.1"
}
